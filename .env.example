# Domain produksi. Dipakai metadataBase, canonical, sitemap, robots, JSON-LD.
# Tanpa trailing slash. Fallback di src/data/statisData.ts -> https://vluffycharm.my.id
NEXT_PUBLIC_SITE_URL=https://vluffycharm.my.id

# Kode verifikasi Google Search Console (meta tag).
# Isi setelah menambahkan properti di Search Console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Tag Manager container. Kosongkan untuk mematikan tracking.
# Contoh: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=
